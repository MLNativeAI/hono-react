{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local", ".env"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env.production.local", ".env.local", ".env.production", ".env"]
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "API_BASE_URL",
        "DASHBOARD_BASE_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "BETTER_AUTH_SECRET",
        "RESEND_API_KEY",
        "FROM_EMAIL",
        "ENVIRONMENT",
        "ENABLE_TEST_UTILS",
        "E2E_API_BASE_URL"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:integration": {
      "cache": false,
      "env": ["DATABASE_URL", "INTEGRATION_DATABASE_URL"]
    },
    "test:unit": {
      "cache": false
    },
    "test:coverage": {
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "paraglide:compile": {},
    "db:generate": {
      "cache": false,
      "outputs": ["drizzle/**"]
    },
    "api:start": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
